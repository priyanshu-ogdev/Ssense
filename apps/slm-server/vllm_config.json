{
  "description": "Optimized SOTA vLLM Multi-LoRA Profile for NVIDIA DGX (Grace-Blackwell / Ada / Ampere)",
  "model": "Qwen/Qwen2.5-7B-Instruct",
  "dtype": "bfloat16",
  "tensor_parallel_size": 1,
  "gpu_memory_utilization": 0.80,
  "max_model_len": 8192,
  "max_num_seqs": 64,
  "swap_space": 4,
  "enable_chunked_prefill": true,
  "enable_prefix_caching": true,
  "prefix_caching_hash_algorithm": "murmur3",
  "enable_lora": true,
  "max_loras": 2,
  "max_lora_rank": 128,
  "max_cpu_loras": 4,
  "lora_modules": [
    "audit_lora=/app/ml/models/audit-model-final-adapter",
    "chatbot_lora=/app/ml/models/chatbot-model-final-adapter"
  ],
  "disable_log_stats": false,
  "port": 8000
}