{
  "description": "Optimized SOTA vLLM Inference Profile for 48GB VRAM Hardware (NVIDIA AGX Thor / RTX 6000 Ada / L40S)",
  "model": "Qwen/Qwen3.5-9B",
  "quantization": "fp8",
  "tensor_parallel_size": 1,
  "gpu_memory_utilization": 0.85,
  "max_model_len": 8192,
  "max_num_seqs": 128,
  "enable_chunked_prefill": true,
  "enable_prefix_caching": true,
  "prefix_caching_hash_algorithm": "murmur3",
  "enable_lora": true,
  "max_loras": 2,
  "max_lora_rank": 128,
  "lora_modules": [
    "audit_lora=/app/ml/models/audit-model-final-adapter",
    "chat_lora=/app/ml/models/chatbot-model-final-adapter"
  ],
  "disable_log_stats": false,
  "port": 8000
}
